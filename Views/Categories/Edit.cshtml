@model Category
@{
    ViewData["Title"] = L["Categories.Edit"].Value;
}
<div class="cf-form-page">
    <a class="cf-back-link" asp-action="Index"><span class="cf-icon cf-icon--arrow-left cf-icon--4" aria-hidden="true"></span>@L["Categories.Back"]</a>
    <h1 class="cf-form-page__title">@L["Categories.Edit"]</h1>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="cf-form-card">
        <input type="hidden" asp-for="Id" />
        <partial name="_Form" />
        <div asp-validation-summary="ModelOnly" class="cf-auth__error"></div>
        <button type="submit" class="cf-btn cf-btn--block">@L["Common.SaveChanges"]</button>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
