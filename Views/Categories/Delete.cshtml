@model DeleteCheck
@{
    ViewData["Title"] = L["Categories.DeleteTitle"].Value;
    var dialog = new DeleteDialogModel(
        Model.Id,
        L["Categories.DeleteTitle"],
        L["Common.CannotUndo"],
        L["Common.Delete"],
        "Index",
        BlockedTitle: Model.Blocked ? L["Categories.CannotDeleteTitle"].Value : null,
        BlockedText: Model.Blocked ? L[Model.BlockedKey!, Model.UsageCount].Value : null);
}
<partial name="_DeleteDialog" model="dialog" />
