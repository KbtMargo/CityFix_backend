@model Category
<div>
    <label class="cf-label" asp-for="Name">@L["Field.NameUk"]</label>
    <label class="cf-field"><input asp-for="Name" class="@(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "cf-input cf-input--error" : "cf-input")" placeholder="@L["Categories.NamePlaceholder"]" /></label>
    <span asp-validation-for="Name" class="cf-field__error"></span>
</div>
<div>
    <label class="cf-label" asp-for="NameEn"></label>
    <label class="cf-field"><input asp-for="NameEn" class="@(ViewData.ModelState["NameEn"]?.Errors.Count > 0 ? "cf-input cf-input--error" : "cf-input")" /><span class="cf-field__hint">@L["Field.NameEnHint"]</span></label>
    <span asp-validation-for="NameEn" class="cf-field__error"></span>
</div>
