@model Category
<div>
    <label class="cf-label" asp-for="Name"></label>
    <label class="cf-field"><input asp-for="Name" class="@(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "cf-input cf-input--error" : "cf-input")" placeholder="@L["Categories.NamePlaceholder"]" /></label>
    <span asp-validation-for="Name" class="cf-field__error"></span>
</div>
