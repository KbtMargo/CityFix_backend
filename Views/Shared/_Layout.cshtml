@{
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var staff = User.IsInRole(nameof(UserRole.Administrator)) || User.IsInRole(nameof(UserRole.AcabAdmin));
    var collapsed = Context.Request.Cookies["cf_sidebar"] == "collapsed";
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @L["App.Name"]</title>
    <partial name="_ThemeScript" />
    <link rel="icon" href="~/images/cityfix-mark.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bundle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body data-col-resize-label="@L["Table.ResizeColumn"]">
    <a class="app-skip" href="#content">@L["Shell.Skip"]</a>
    <div class="@(staff ? "cf-shell cf-shell--admin" : "cf-shell") app-shell @(collapsed ? "is-collapsed" : "")" data-app-shell>
        <aside class="cf-shell__sidebar" id="app-sidebar" aria-label="@L["Nav.Label"]">@await Component.InvokeAsync("Sidebar")</aside>
        <div class="app-shell__scrim" data-sidebar-close></div>
        <main class="cf-shell__main">
            <header class="cf-topbar app-topbar">
                <button type="button" class="cf-btn cf-btn--ghost cf-btn--icon app-topbar__menu" data-sidebar-open aria-controls="app-sidebar"
                        aria-expanded="false" aria-label="@L["Shell.Open"]" title="@L["Shell.Open"]">
                    <span class="cf-icon cf-icon--menu cf-icon--5" aria-hidden="true"></span>
                </button>
                <div class="app-topbar__end">
                    <partial name="_ThemeToggle" />
                    <partial name="_CultureSwitch" />
                </div>
            </header>
            <div class="@(staff ? "cf-stack-6 app-content--admin" : "cf-page") app-content" id="content" tabindex="-1">
                <partial name="_Flash" />
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
