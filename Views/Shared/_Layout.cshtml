@{
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    // Residents get the 320px white sidebar; association heads and administrators the 280px admin shell.
    var staff = User.IsInRole(nameof(UserRole.Administrator)) || User.IsInRole(nameof(UserRole.AcabAdmin));
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @L["App.Name"]</title>
    <script>document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'</script>
    <link rel="icon" href="~/images/cityfix-mark.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bundle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="@(staff ? "cf-shell cf-shell--admin" : "cf-shell")">
        <aside class="cf-shell__sidebar">@await Component.InvokeAsync("Sidebar")</aside>
        <main class="cf-shell__main">
            <div class="@(staff ? "cf-stack-6" : "cf-page")">
                @* The view body has already run when the layout executes, so the detail modal can claim an error first. *@
                <partial name="_Flash" />
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
