@* Goes right after a password input inside .app-password; site.js reveals it (it stays hidden without JavaScript). *@
<button type="button" class="app-password__toggle" data-password-toggle hidden aria-pressed="false"
        aria-label="@L["Auth.Password.Show"]" title="@L["Auth.Password.Show"]"
        data-label-show="@L["Auth.Password.Show"]" data-label-hide="@L["Auth.Password.Hide"]">
    <span class="cf-icon cf-icon--eye cf-icon--4" aria-hidden="true"></span>
</button>
