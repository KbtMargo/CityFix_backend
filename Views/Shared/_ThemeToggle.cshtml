<button type="button" class="cf-btn cf-btn--ghost cf-btn--icon app-theme-toggle" data-theme-toggle hidden
        data-label-dark="@L["Theme.ToDark"]" data-label-light="@L["Theme.ToLight"]" aria-label="@L["Theme.ToDark"]" title="@L["Theme.ToDark"]">
    <span class="cf-icon cf-icon--moon cf-icon--5 app-theme-toggle__moon" aria-hidden="true"></span>
    <span class="cf-icon cf-icon--sun cf-icon--5 app-theme-toggle__sun" aria-hidden="true"></span>
</button>
