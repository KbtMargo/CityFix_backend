@model AppealListViewModel
@{
    var d = Model.Selected!;
    var a = d.Appeal;
    var closeRoute = Model.Filter.ToRouteValues(includePage: true).ToDictionary(kv => kv.Key, kv => (object?)kv.Value);
    var closeUrl = Url.Action(Model.Action, Model.Controller, new RouteValueDictionary(closeRoute));
    var currentUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;

    var updateError = TempData[CityFix_backend.Controllers.AppController.ErrorKey] as string;
    var keptComment = TempData["Comment"] as string;
    var keptStatus = Enum.TryParse<AppealStatus>(TempData["Status"] as string, out var s) ? s : a.Status;
    var keptPriority = Enum.TryParse<AppealPriority>(TempData["Priority"] as string, out var p) ? p : a.Priority;
    // HttpContext.Items rather than ViewData: a <partial> works on a copy of ViewData, so the layout would never see the flag.
    // Only when a form footer below shows the error; otherwise the page-level flash must.
    if (updateError != null && (d.CanRate || d.CanProcess)) { Context.Items["FlashHandled"] = true; }

    var statuses = new[] { a.Status }.Concat(d.NextStatuses).ToList();
    var responsibleName = a.ResponsibleKind == ResponsibleKind.Association ? a.Acab?.DisplayName() : a.Recipient?.DisplayName();
    var responsibleValue = AppealFormViewModel.ResponsibleValue(a);
}
<div class="cf-overlay" data-close-href="@closeUrl">
    <div class="cf-modal" role="dialog" aria-modal="true" aria-labelledby="appeal-title">
        <div class="cf-modal__head">
            <div class="cf-modal__titlebar">
                <h2 class="cf-modal__title" id="appeal-title">@a.DisplayTitle()</h2>
                <div class="cf-modal__actions">
                    @if (d.CanEdit)
                    {
                        <a class="cf-btn cf-btn--outline cf-btn--sm" asp-controller="Appeals" asp-action="Edit" asp-route-id="@a.Id"><span class="cf-icon cf-icon--edit cf-icon--4" aria-hidden="true"></span>@L["Common.Edit"]</a>
                    }
                    @if (d.CanDelete)
                    {
                        <a class="cf-btn cf-btn--outline cf-btn--sm" asp-controller="Appeals" asp-action="Delete" asp-route-id="@a.Id"><span class="cf-icon cf-icon--trash cf-icon--4" aria-hidden="true"></span>@L["Common.Delete"]</a>
                    }
                    <a class="cf-modal__close" href="@closeUrl" aria-label="@L["Common.Close"]"><span class="cf-icon cf-icon--x-lucide cf-icon--6" aria-hidden="true"></span></a>
                </div>
            </div>
            <div class="cf-chips">
                <partial name="_StatusPill" model="a.Status" />
                <span class="cf-pill cf-pill--neutral">@a.Category?.DisplayName()</span>
                <partial name="_PriorityPill" model="a.Priority" />
                @if (d.Overdue)
                {
                    <span class="cf-badge cf-badge--danger">@L["Deadline.Overdue"]</span>
                }
            </div>
            @if (d.CanSupport)
            {
                <partial name="_SupportButton" model="(a.Id, d.Supported, a.SupportCount)" />
            }
        </div>

        <div class="cf-modal__body">
            @if (a.Files.Count > 0)
            {
                var first = a.Files[0];
                <div class="cf-modal__section" data-cf-gallery>
                    <h3 class="cf-modal__h">@L["Modal.Photos"]</h3>
                    <div class="cf-carousel">
                        @if (a.Files.Count > 1)
                        {
                            <button type="button" class="cf-carousel__btn cf-carousel__btn--prev" data-gallery-step="-1" aria-label="@L["Modal.PrevPhoto"]"><span class="cf-icon cf-icon--chevron-left cf-icon--6" aria-hidden="true"></span></button>
                        }
                        <img src="@Url.Action("Photo", "Appeals", new { id = first.Id })" alt="@L["Modal.PhotoAlt"]" data-gallery-main />
                        @if (a.Files.Count > 1)
                        {
                            <button type="button" class="cf-carousel__btn cf-carousel__btn--next" data-gallery-step="1" aria-label="@L["Modal.NextPhoto"]"><span class="cf-icon cf-icon--chevron-right cf-icon--6" aria-hidden="true"></span></button>
                        }
                    </div>
                    @if (a.Files.Count > 1)
                    {
                        <div class="cf-thumbs">
                            @for (var i = 0; i < a.Files.Count; i++)
                            {
                                <button type="button" class="cf-thumb @(i == 0 ? "is-active" : "")" data-gallery-src="@Url.Action("Photo", "Appeals", new { id = a.Files[i].Id })" aria-label="@L["Modal.PhotoN", i + 1]"><img src="@Url.Action("Photo", "Appeals", new { id = a.Files[i].Id, thumb = true })" alt="" /></button>
                            }
                        </div>
                    }
                </div>
            }

            <div class="cf-modal__section">
                <h3 class="cf-modal__h">@L["Field.Description"]</h3>
                <p class="cf-modal__text">@(a.DisplayDescription() ?? L["Modal.NoDescription"].Value)</p>
                @if (a.ShowsTranslation())
                {
                    <details class="app-translation">
                        <summary>@L["Translation.Auto"] · @L["Translation.ShowOriginal"]</summary>
                        <p class="cf-modal__text"><b>@a.Title</b></p>
                        @if (a.Description != null)
                        {
                            <p class="cf-modal__text">@a.Description</p>
                        }
                    </details>
                }
            </div>

            <div class="cf-modal__facts">
                <div class="cf-fact">
                    <div class="cf-fact__label"><span class="cf-icon cf-icon--map-pin cf-icon--4" aria-hidden="true"></span> @L["Modal.Place"]</div>
                    <p class="cf-fact__value">@(a.DisplayAddress() ?? L["Appeal.Coordinates", a.Lat.Coordinate(), a.Lng.Coordinate()].Value)</p>
                </div>
                <div class="cf-fact">
                    <div class="cf-fact__label"><span class="cf-icon cf-icon--calendar cf-icon--4" aria-hidden="true"></span> @L["Modal.Reported"]</div>
                    <p class="cf-fact__value">@a.CreatedAt.ToDateTime()</p>
                </div>
                @if (a.DueAt != null && AppealWorkflow.Open.Contains(a.Status))
                {
                    <div class="cf-fact">
                        <div class="cf-fact__label"><span class="cf-icon cf-icon--clock cf-icon--4" aria-hidden="true"></span> @L["Deadline.Label"]</div>
                        <p class="cf-fact__value @(d.Overdue ? "app-overdue" : "")">@a.DueAt.Value.ToDate()@(d.Overdue ? $" · {L["Deadline.Overdue"].Value}" : "")</p>
                    </div>
                }
                @if (a.ClosedAt != null && AppealWorkflow.Closed.Contains(a.Status))
                {
                    <div class="cf-fact">
                        <div class="cf-fact__label"><span class="cf-icon cf-icon--calendar cf-icon--4" aria-hidden="true"></span> @L["Deadline.Closed"]</div>
                        <p class="cf-fact__value">@a.ClosedAt.Value.ToDateTime()</p>
                    </div>
                }
                @if (a.Rating != null)
                {
                    <div class="cf-fact">
                        <div class="cf-fact__label"><span class="cf-icon cf-icon--check cf-icon--4" aria-hidden="true"></span> @L["Rating.Label"]</div>
                        <p class="cf-fact__value"><span class="app-stars" aria-hidden="true">@(new string('★', a.Rating.Value))@(new string('☆', 5 - a.Rating.Value))</span> @L["Rating.OutOf", a.Rating.Value]</p>
                    </div>
                }
                @if (a.SupportCount > 0 && !d.CanSupport)
                {
                    <div class="cf-fact">
                        <div class="cf-fact__label"><span class="cf-icon cf-icon--users cf-icon--4" aria-hidden="true"></span> @L["Support.Label"]</div>
                        <p class="cf-fact__value">@L["Support.Count", a.SupportCount]</p>
                    </div>
                }
                <div class="cf-fact">
                    <div class="cf-fact__label"><span class="cf-icon cf-icon--wrench cf-icon--4" aria-hidden="true"></span> @L["Field.Responsible"]</div>
                    <p class="cf-fact__value">@(responsibleName ?? L["Appeal.NoResponsible"].Value)</p>
                </div>
                @if (a.Acab != null)
                {
                    <div class="cf-fact">
                        <div class="cf-fact__label"><span class="cf-icon cf-icon--apartment cf-icon--4" aria-hidden="true"></span> @L["Field.Acab"]</div>
                        <p class="cf-fact__value">@a.Acab.DisplayName()</p>
                    </div>
                }
                @if (Model.IsStaff)
                {
                    <div class="cf-fact">
                        <div class="cf-fact__label"><span class="cf-icon cf-icon--users cf-icon--4" aria-hidden="true"></span> @L["Field.Author"]</div>
                        <p class="cf-fact__value">@a.Author?.DisplayName()</p>
                    </div>
                }
            </div>

            @if (d.Similar.Count > 0)
            {
                <div class="cf-modal__section">
                    <h3 class="cf-modal__h">@L["Similar.Title"]</h3>
                    <ul class="app-similar__list">
                        @foreach (var item in d.Similar)
                        {
                            <li>
                                @if (item.Visible)
                                {
                                    var route = Model.Filter.ToRouteValues(includePage: true);
                                    route["appealId"] = item.Id.ToString();
                                    <a class="app-similar__name" asp-controller="@Model.Controller" asp-action="@Model.Action" asp-all-route-data="route">@item.Title</a>
                                }
                                else
                                {
                                    <span class="app-similar__name">@L["Similar.Hidden"]</span>
                                }
                                <span class="app-similar__meta">@item.Status.GetDisplayName() · @item.CreatedAt.ToDate() · @L["Appeal.Distance", item.DistanceMeters]</span>
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="cf-modal__section">
                <h3 class="cf-modal__h">@L["Timeline.Title"]</h3>
                <div class="cf-timeline">
                    <div class="cf-timeline__item">
                        <div class="cf-timeline__dot"><span class="cf-icon cf-icon--file-text cf-icon--3" aria-hidden="true"></span></div>
                        <div class="cf-timeline__content"><p class="cf-timeline__title">@L["Timeline.Submitted"]</p><p class="cf-timeline__time">@a.CreatedAt.ToDateTime()</p></div>
                    </div>
                    @foreach (var u in a.Updates)
                    {
                        var titles = new List<string>();
                        if (u.StatusChanged) titles.Add(L["Timeline.StatusChanged", u.OldStatus.GetDisplayName(), u.NewStatus.GetDisplayName()].Value);
                        if (u.PriorityChanged) titles.Add(L["Timeline.PriorityChanged", u.OldPriority!.Value.GetDisplayName(), u.NewPriority!.Value.GetDisplayName()].Value);
                        if (u.AssignedTo != null) titles.Add(L["Timeline.Assigned", u.DisplayAssignedTo()!].Value);
                        if (u.Rating != null) titles.Add(L["Timeline.Rated", u.Rating.Value].Value);
                        if (titles.Count == 0) titles.Add(L["Timeline.CommentAdded"].Value);
                        <div class="cf-timeline__item">
                            <div class="cf-timeline__dot cf-timeline__dot--@u.NewStatus.PillModifier()"></div>
                            <div class="cf-timeline__content">
                                @foreach (var title in titles)
                                {
                                    <p class="cf-timeline__title">@title</p>
                                }
                                <p class="cf-timeline__time">@u.ChangedAt.ToDateTime()@(Model.IsStaff && u.ChangedBy != null ? $" · {u.ChangedBy.DisplayName()}" : "")</p>
                                @if (!string.IsNullOrWhiteSpace(u.Comment))
                                {
                                    <p class="cf-timeline__comment">@u.Comment</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (d.CanRate)
        {
            var keptReopen = TempData["ReopenComment"] as string;
            <div class="cf-modal__foot cf-stack-4">
                @if (updateError != null)
                {
                    <div class="cf-alert" role="alert">@updateError</div>
                }
                <form class="cf-update-panel" asp-controller="Appeals" asp-action="Rate" method="post">
                    <h3 class="cf-update-panel__title">@L["Rating.Title"]</h3>
                    <p class="cf-help">@L["Rating.Hint"]</p>
                    <input type="hidden" name="appealId" value="@a.Id" />
                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                    <fieldset class="app-rating">
                        <legend class="cf-sr-only">@L["Rating.Label"]</legend>
                        @for (var r = 5; r >= 1; r--)
                        {
                            <input type="radio" id="rating-@r" name="rating" value="@r" required />
                            <label for="rating-@r" title="@L["Rating.OutOf", r]"><span aria-hidden="true">★</span><span class="cf-sr-only">@L["Rating.OutOf", r]</span></label>
                        }
                    </fieldset>
                    <div>
                        <label class="cf-label cf-label--muted" for="rating-comment">@L["Rating.Comment"]</label>
                        <textarea id="rating-comment" name="comment" class="cf-textarea app-control-gap" rows="2" maxlength="@Appeal.MaxRatingCommentLength"></textarea>
                    </div>
                    <button type="submit" class="cf-btn cf-btn--block">@L["Rating.Submit"]</button>
                </form>

                @if (d.CanReopen)
                {
                    <form class="cf-update-panel" asp-controller="Appeals" asp-action="Reopen" method="post">
                        <h3 class="cf-update-panel__title">@L["Reopen.Title"]</h3>
                        <input type="hidden" name="appealId" value="@a.Id" />
                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                        <div>
                            <label class="cf-label cf-label--muted" for="reopen-comment">@L["Reopen.Comment"]</label>
                            <textarea id="reopen-comment" name="comment" class="cf-textarea app-control-gap" rows="3" maxlength="@AppealUpdate.MaxCommentLength" required placeholder="@L["Reopen.Placeholder"]">@keptReopen</textarea>
                            <p class="cf-help">@L["Reopen.Hint"]</p>
                        </div>
                        <button type="submit" class="cf-btn cf-btn--outline cf-btn--block">@L["Reopen.Submit"]</button>
                    </form>
                }
            </div>
        }

        @if (d.CanProcess)
        {
            <div class="cf-modal__foot cf-stack-4">
                @if (updateError != null)
                {
                    <div class="cf-alert" role="alert">@updateError</div>
                }
                <form class="cf-update-panel" asp-controller="Appeals" asp-action="Process" method="post">
                    <h3 class="cf-update-panel__title">@L["Update.Title"]</h3>
                    <input type="hidden" name="appealId" value="@a.Id" />
                    <input type="hidden" name="expectedStatus" value="@a.Status" />
                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                    <div class="cf-form-grid">
                        <div>
                            <label class="cf-label cf-label--muted" for="update-status">@L["Field.Status"]</label>
                            <div class="cf-select app-control-gap">
                                <select id="update-status" name="status">
                                    @foreach (var status in statuses)
                                    {
                                        <option value="@status" selected="@(status == keptStatus)">@status.GetDisplayName()</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div>
                            <label class="cf-label cf-label--muted" for="update-priority">@L["Field.Priority"]</label>
                            <div class="cf-select app-control-gap">
                                <select id="update-priority" name="priority">
                                    @foreach (var priority in Enum.GetValues<AppealPriority>())
                                    {
                                        <option value="@priority" selected="@(priority == keptPriority)">@priority.GetDisplayName()</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    @if (AppealWorkflow.IsFinal(a.Status))
                    {
                        <p class="cf-help">@L["Update.FinalHint"]</p>
                    }
                    <div>
                        <label class="cf-label cf-label--muted" for="update-comment">@L["Update.Comment"]</label>
                        <textarea id="update-comment" name="comment" class="cf-textarea app-control-gap" rows="4" maxlength="1000" placeholder="@L["Update.CommentPlaceholder"]">@keptComment</textarea>
                        <p class="cf-help">@L["Update.CommentHint"]</p>
                    </div>
                    <button type="submit" class="cf-btn cf-btn--block">@L["Common.SaveChanges"]</button>
                </form>

                @if (d.CanAssign)
                {
                    <form class="cf-update-panel" asp-controller="Appeals" asp-action="Assign" method="post">
                        <h3 class="cf-update-panel__title">@L["Assign.Title"]</h3>
                        <input type="hidden" name="appealId" value="@a.Id" />
                        <input type="hidden" name="returnUrl" value="@currentUrl" />
                        <div>
                            <label class="cf-label cf-label--muted" for="assign-responsible">@L["Field.Responsible"]</label>
                            <div class="cf-select app-control-gap">
                                <select id="assign-responsible" name="responsible">
                                    @if (a.Acab != null)
                                    {
                                        <option value="@AppealFilter.ResponsibleAcab" selected="@(responsibleValue == AppealFilter.ResponsibleAcab)">@L["Responsible.Acab", a.Acab.Name]</option>
                                    }
                                    <optgroup label="@L["Responsible.Services"]">
                                        @foreach (var r in Model.Lookups.Recipients)
                                        {
                                            <option value="@r.Id" selected="@(responsibleValue == r.Id.ToString())">@r.DisplayName()</option>
                                        }
                                    </optgroup>
                                </select>
                            </div>
                            <p class="cf-help">@L["Assign.Hint"]</p>
                        </div>
                        <button type="submit" class="cf-btn cf-btn--outline cf-btn--block">@L["Assign.Submit"]</button>
                    </form>
                }
            </div>
        }
    </div>
</div>
