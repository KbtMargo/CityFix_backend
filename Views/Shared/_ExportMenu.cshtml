@* "Export" button with a menu of formats (<details>, so it works without JS; site.js closes it on an outside
   click or Escape). Excel and PDF are formatted reports; CSV and JSON are raw data for other programs. *@
@model ExportMenuModel
<details class="app-menu" data-menu>
    <summary class="cf-btn cf-btn--outline cf-btn--sm"><span class="cf-icon cf-icon--download cf-icon--4" aria-hidden="true"></span>@L["Export.Title"]<span class="cf-icon cf-icon--chevron-down cf-icon--4" aria-hidden="true"></span></summary>
    <div class="app-menu__list" role="menu">
        @foreach (var format in Model.Formats)
        {
            var route = new Dictionary<string, string>(Model.Route) { ["format"] = format };
            <a class="app-menu__item" role="menuitem" asp-controller="@Model.Controller" asp-action="Export" asp-all-route-data="route">
                <span class="app-menu__label">@L[$"Export.{format}"]</span>
                <span class="app-menu__hint">@L[$"Export.{format}.Hint"]</span>
            </a>
        }
    </div>
</details>
