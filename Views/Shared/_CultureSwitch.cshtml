@* UA/EN switch: the segmented Tabs pattern as two submit buttons. Only the UI language changes. *@
@{
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
}
<form method="post" asp-controller="Culture" asp-action="Set">
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    <div class="cf-tabs" role="tablist" aria-label="@L["Language.Label"]">
        <button type="submit" name="culture" value="uk" class="cf-tab" role="tab" lang="uk" aria-selected="@(lang == "uk" ? "true" : "false")" title="Українська">UA</button>
        <button type="submit" name="culture" value="en" class="cf-tab" role="tab" lang="en" aria-selected="@(lang == "en" ? "true" : "false")" title="English">EN</button>
    </div>
</form>
