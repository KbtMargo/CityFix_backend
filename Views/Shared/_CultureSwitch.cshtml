@{
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
}
<form method="post" asp-controller="Culture" asp-action="Set">
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    <div class="cf-tabs" role="group" aria-label="@L["Language.Label"]">
        <button type="submit" name="culture" value="uk" class="cf-tab @(lang == "uk" ? "is-active" : "")" lang="uk" aria-pressed="@(lang == "uk" ? "true" : "false")" title="Українська">UA</button>
        <button type="submit" name="culture" value="en" class="cf-tab @(lang == "en" ? "is-active" : "")" lang="en" aria-pressed="@(lang == "en" ? "true" : "false")" title="English">EN</button>
    </div>
</form>
