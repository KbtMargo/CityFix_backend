@model ErrorViewModel
@{
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
    ViewData["Title"] = L["Error.Server.Title"].Value;
}
<div class="cf-error-page">
    <div class="cf-empty">
        <div class="cf-empty__tile"><span class="cf-icon cf-icon--alert cf-icon--6" aria-hidden="true"></span></div>
        <p class="cf-error-page__code">@(Context.Response.StatusCode >= 400 ? Context.Response.StatusCode : 500)</p>
        <div class="cf-empty__title">@L["Error.Server.Title"]</div>
        <div class="cf-empty__text">@L["Error.Server.Text"]</div>
        @if (Model?.ShowRequestId == true)
        {
            <div class="cf-empty__text">@L["Error.RequestId"]: <code>@Model.RequestId</code></div>
        }
        <div class="cf-error-page__actions">
            <a class="cf-applink cf-applink--soft" href="javascript:history.back()"><span class="cf-icon cf-icon--arrow-left cf-icon--4" aria-hidden="true"></span>@L["Common.Back"]</a>
            <a class="cf-applink" asp-controller="Dashboard" asp-action="Index">@L["Error.ToDashboard"]</a>
        </div>
    </div>
</div>
