@model DeleteDialogModel
@{
    var cancelUrl = Url.Action(Model.CancelAction, Model.CancelRoute);
}
<div class="cf-overlay cf-overlay--dialog" data-close-href="@cancelUrl">
    <div class="cf-panel-modal cf-panel-modal--sm" role="dialog" aria-modal="true" aria-labelledby="delete-title">
        <h2 class="cf-panel-modal__title cf-panel-modal__title--danger" id="delete-title"><span class="cf-icon cf-icon--alert cf-icon--5" aria-hidden="true"></span>@Model.Title</h2>
        @if (Model.Blocked)
        {
            <div class="cf-alert cf-alert--box"><p class="cf-alert__title">@Model.BlockedTitle</p><p>@Model.BlockedText</p></div>
        }
        <p class="cf-panel-modal__text">@Model.Text</p>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="cf-panel-modal__foot">
            <a class="cf-btn cf-btn--outline" href="@cancelUrl">@L["Common.Close"]</a>
            <button type="submit" class="cf-btn cf-btn--destructive" disabled="@Model.Blocked">@Model.ConfirmLabel</button>
        </form>
    </div>
</div>
