@* The CityFix lockup. The name and tagline live only in the App.Name / App.Tagline resource keys. *@
<a class="cf-logo" asp-controller="Home" asp-action="Index">
    <span class="cf-logo__mark"><partial name="_LogoMark" /></span>
    <span class="cf-logo__text"><span class="cf-logo__name">@L["App.Name"]</span><span class="cf-logo__tag">@L["App.Tagline"]</span></span>
</a>
