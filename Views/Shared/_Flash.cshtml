@* One-off feedback after a redirect (this design has no toasts). The detail modal shows its own error and sets FlashHandled.
   With JS the close button dismisses the message; without it the message simply stays until the next page. *@
@if (ViewData["FlashHandled"] is not true && TempData[CityFix_backend.Controllers.AppController.ErrorKey] is string error)
{
    <div class="cf-alert app-flash" role="alert" data-flash>
        <span class="cf-icon cf-icon--alert-circle cf-icon--4" aria-hidden="true"></span><span class="app-flash__text">@error</span>
        <button type="button" class="app-flash__close" data-flash-close hidden aria-label="@L["Common.Close"]"><span class="cf-icon cf-icon--x-lucide cf-icon--4" aria-hidden="true"></span></button>
    </div>
}
@if (TempData[CityFix_backend.Controllers.AppController.SuccessKey] is string success)
{
    <div class="cf-alert app-flash app-flash--success" role="status" data-flash>
        <span class="cf-icon cf-icon--check-circle cf-icon--4" aria-hidden="true"></span><span class="app-flash__text">@success</span>
        <button type="button" class="app-flash__close" data-flash-close hidden aria-label="@L["Common.Close"]"><span class="cf-icon cf-icon--x-lucide cf-icon--4" aria-hidden="true"></span></button>
    </div>
}
