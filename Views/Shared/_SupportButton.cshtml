@model (int AppealId, bool Supported, int Count)
@* "Affects me too": site.js posts it with fetch and updates the label and counter in place. *@
<div class="app-support">
    <button type="button" class="cf-btn cf-btn--sm @(Model.Supported ? "" : "cf-btn--outline") app-support__button" data-support
            data-url="@Url.Action("Support", "Appeals", new { id = Model.AppealId })" aria-pressed="@(Model.Supported ? "true" : "false")"
            data-label-on="@L["Support.Done"]" data-label-off="@L["Support.Button"]"
            data-title-on="@L["Support.Undo"]" title="@(Model.Supported ? L["Support.Undo"].Value : null)">
        <span class="cf-icon cf-icon--users cf-icon--4" aria-hidden="true"></span>
        <span data-support-label>@L[Model.Supported ? "Support.Done" : "Support.Button"]</span>
    </button>
    <span class="app-support__count" data-support-count @(Model.Count > 0 ? "" : "hidden")>@L["Support.Count", Model.Count]</span>
</div>
