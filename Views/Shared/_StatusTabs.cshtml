@* Segmented tabs: All / New / In progress / Closed (Done + Rejected). Keeps the other filters. *@
@model AppealListViewModel
@{
    var current = Model.Filter.CurrentTab;
    var tabs = new[]
    {
        (Key: AppealFilter.TabAll, Label: "Tabs.All"),
        (Key: AppealFilter.TabNew, Label: "Tabs.New"),
        (Key: AppealFilter.TabInProgress, Label: "Tabs.InProgress"),
        (Key: AppealFilter.TabClosed, Label: "Tabs.Closed")
    };
}
@* Links that reload the list, so a nav with aria-current rather than ARIA tabs. *@
<nav class="cf-tabs" aria-label="@L["Tabs.Label"]">
    @foreach (var tab in tabs)
    {
        var route = Model.Filter.ToRouteValues(includeTab: false);
        if (tab.Key != AppealFilter.TabAll) { route["tab"] = tab.Key; }
        <a class="cf-tab @(current == tab.Key ? "is-active" : "")" aria-current="@(current == tab.Key ? "true" : null)" asp-controller="@Model.Controller" asp-action="@Model.Action" asp-all-route-data="route">@L[tab.Label]</a>
    }
</nav>
