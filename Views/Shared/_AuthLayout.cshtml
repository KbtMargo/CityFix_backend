@* Login and register: no sidebar, the centred auth card; the logo (back to the landing page) top-left,
   the theme and language switches top-right, where they sit on every other page too. *@
@{
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @L["App.Name"]</title>
    <partial name="_ThemeScript" />
    <link rel="icon" href="~/images/cityfix-mark.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bundle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-auth">
        <div class="app-auth__home"><partial name="_Logo" /></div>
        <div class="app-auth__lang"><partial name="_ThemeToggle" /><partial name="_CultureSwitch" /></div>
        @RenderBody()
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
