@* Category.Icon may hold a Bootstrap Icons class (e.g. "bi-lightbulb") or plain text / an emoji. *@
@model string
@if (!string.IsNullOrWhiteSpace(Model))
{
    if (Model.StartsWith("bi-", StringComparison.OrdinalIgnoreCase))
    {
        <i class="bi @Model"></i>
    }
    else
    {
        <span>@Model</span>
    }
}
