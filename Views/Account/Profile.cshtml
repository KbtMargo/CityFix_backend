@model ProfileViewModel
@{
    var user = Model.User;
    ViewData["Title"] = L["Profile.Title"].Value;
    string InputClass(string field) => ViewData.ModelState[field]?.Errors.Count > 0 ? "cf-input cf-input--error" : "cf-input";
}
<div>
    <h1 class="cf-page-title">@L["Profile.Title"]</h1>
    <p class="cf-page-sub">@L["Profile.Sub"]</p>
</div>

<div class="cf-card">
    <div class="cf-card__head">
        <div class="cf-card__title">@user.DisplayName()</div>
        <div class="cf-card__desc"><span class="cf-tag cf-tag--@user.Role.RoleTag()">@user.Role.GetDisplayName()</span></div>
    </div>
    <div class="cf-card__body">
        <div class="cf-form-grid">
            <div class="cf-fact"><div class="cf-fact__label">@L["Field.Acab"]</div><p class="cf-fact__value">@(user.Acab?.DisplayName() ?? L["Common.NotSpecified"].Value)</p></div>
            <div class="cf-fact"><div class="cf-fact__label">@L["Profile.MemberSince"]</div><p class="cf-fact__value">@user.CreatedAt.ToDate()</p></div>
        </div>
    </div>
</div>

<div class="cf-card">
    <div class="cf-card__head">
        <div class="cf-card__title">@L["Profile.EditTitle"]</div>
        <div class="cf-card__desc">@L["Profile.EditHint"]</div>
    </div>
    <div class="cf-card__body">
        <form asp-action="UpdateProfile" method="post" class="cf-stack-6">
            <div class="cf-form-grid">
                <div>
                    <label class="cf-label" asp-for="Profile.FirstName"></label>
                    <label class="cf-field"><input asp-for="Profile.FirstName" class="@InputClass("Profile.FirstName")" autocomplete="given-name" /></label>
                    <span asp-validation-for="Profile.FirstName" class="cf-field__error"></span>
                </div>
                <div>
                    <label class="cf-label" asp-for="Profile.LastName"></label>
                    <label class="cf-field"><input asp-for="Profile.LastName" class="@InputClass("Profile.LastName")" autocomplete="family-name" /></label>
                    <span asp-validation-for="Profile.LastName" class="cf-field__error"></span>
                </div>
            </div>
            <div class="cf-form-grid">
                <div>
                    <label class="cf-label" asp-for="Profile.Email"></label>
                    <label class="cf-field"><input asp-for="Profile.Email" class="@InputClass("Profile.Email")" autocomplete="email" /></label>
                    <span asp-validation-for="Profile.Email" class="cf-field__error"></span>
                </div>
                <div>
                    <label class="cf-label" asp-for="Profile.Phone">@L["Field.PhoneOptional"]</label>
                    <label class="cf-field"><input asp-for="Profile.Phone" class="@InputClass("Profile.Phone")" type="tel" autocomplete="tel" placeholder="+380..." /></label>
                    <span asp-validation-for="Profile.Phone" class="cf-field__error"></span>
                </div>
            </div>
            <div><button type="submit" class="cf-btn">@L["Common.SaveChanges"]</button></div>
        </form>
        @if (user.PendingEmail != null)
        {
            <form asp-action="ResendPendingEmail" method="post" class="cf-stack-4 app-profile-pending">
                <p class="cf-field__hint">@L["Profile.EmailPendingNote", user.PendingEmail, user.Email]</p>
                <div><button type="submit" class="cf-btn cf-btn--outline">@L["Auth.Resend.Submit"]</button></div>
            </form>
        }
    </div>
</div>

<div class="cf-card">
    <div class="cf-card__head">
        <div class="cf-card__title">@L["Profile.NotificationsTitle"]</div>
        <div class="cf-card__desc">@L["Profile.NotificationsHint"]</div>
    </div>
    <div class="cf-card__body">
        <form asp-action="UpdateNotifications" method="post" class="cf-stack-6">
            <div class="cf-stack-4">
                <div>
                    <label class="cf-check"><input asp-for="Notifications.InApp" /><span>@Html.DisplayNameFor(m => m.Notifications.InApp)</span></label>
                </div>
                <div>
                    <label class="cf-check"><input asp-for="Notifications.Email" /><span>@Html.DisplayNameFor(m => m.Notifications.Email)</span></label>
                    <p class="cf-field__hint">@(user.EmailConfirmed ? L["Profile.Notify.EmailTo", user.Email] : L["Profile.Notify.EmailUnconfirmed"])</p>
                </div>
                <div>
                    <label class="cf-check"><input asp-for="Notifications.Sms" /><span>@Html.DisplayNameFor(m => m.Notifications.Sms)</span></label>
                    <p class="cf-field__hint">@(PhoneNumber.ToE164(user.Phone) is string phone ? L["Profile.Notify.SmsTo", phone] : L["Profile.Notify.SmsNoPhone"])</p>
                </div>
            </div>
            <div><button type="submit" class="cf-btn">@L["Common.SaveChanges"]</button></div>
        </form>
    </div>
</div>

<div class="cf-card">
    <div class="cf-card__head">
        <div class="cf-card__title">@L["Profile.ChangePassword"]</div>
        <div class="cf-card__desc">@L["Profile.ChangePasswordHint"]</div>
    </div>
    <div class="cf-card__body">
        <form asp-action="ChangePassword" method="post" class="cf-stack-6">
            <div>
                <label class="cf-label" asp-for="ChangePassword.CurrentPassword"></label>
                <label class="cf-field"><input asp-for="ChangePassword.CurrentPassword" class="cf-input" autocomplete="current-password" /></label>
                <span asp-validation-for="ChangePassword.CurrentPassword" class="cf-field__error"></span>
            </div>
            <div class="cf-form-grid">
                <div>
                    <label class="cf-label" asp-for="ChangePassword.NewPassword"></label>
                    <label class="cf-field"><input asp-for="ChangePassword.NewPassword" class="cf-input" autocomplete="new-password" /><span class="cf-field__hint">@L["Profile.PasswordHint"]</span></label>
                    <span asp-validation-for="ChangePassword.NewPassword" class="cf-field__error"></span>
                </div>
                <div>
                    <label class="cf-label" asp-for="ChangePassword.ConfirmPassword"></label>
                    <label class="cf-field"><input asp-for="ChangePassword.ConfirmPassword" class="cf-input" autocomplete="new-password" /></label>
                    <span asp-validation-for="ChangePassword.ConfirmPassword" class="cf-field__error"></span>
                </div>
            </div>
            <div><button type="submit" class="cf-btn">@L["Profile.ChangePassword"]</button></div>
        </form>
    </div>
</div>

<div class="cf-card">
    <div class="cf-card__head">
        <div class="cf-card__title">@L["Profile.Data.Title"]</div>
        <div class="cf-card__desc">@L["Profile.Data.Hint"]</div>
    </div>
    <div class="cf-card__body cf-stack-6">
        <div><a class="cf-btn cf-btn--outline" asp-action="ExportData">@L["Profile.Data.Export"]</a></div>
        <form asp-action="DeleteAccount" method="post" class="cf-stack-6">
            <p class="cf-help">@L["Profile.Delete.Warning"]</p>
            <div>
                <label class="cf-label" for="delete-password">@L["Field.CurrentPassword"]</label>
                <label class="cf-field"><input id="delete-password" name="password" type="password" class="cf-input" autocomplete="current-password" required /></label>
            </div>
            <div><button type="submit" class="cf-btn cf-btn--destructive">@L["Profile.Delete.Submit"]</button></div>
        </form>
    </div>
</div>

<form asp-action="Logout" method="post">
    <button type="submit" class="cf-btn cf-btn--outline cf-btn--icon-gap"><span class="cf-icon cf-icon--log-out cf-icon--4" aria-hidden="true"></span>@L["Profile.Logout"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
