@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Auth.Login.Title"].Value;
    var error = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).FirstOrDefault();
}
<div class="cf-auth cf-auth--login">
    <div class="cf-auth__card">
        <div class="cf-auth__head">
            <h1 class="cf-auth__title">@L["Auth.Login.Title"]</h1>
            <p class="cf-auth__sub">@L["Auth.Login.Sub"]</p>
        </div>
        <partial name="_Flash" />
        <form asp-action="Login" method="post" class="cf-stack-6" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div><label class="cf-auth__label" asp-for="Email"></label><input asp-for="Email" class="cf-auth__input" autocomplete="email" placeholder="you@example.com" /></div>
            <div><label class="cf-auth__label" asp-for="Password"></label><input asp-for="Password" class="cf-auth__input" autocomplete="current-password" placeholder="••••••••" /></div>
            <label class="cf-check"><input asp-for="RememberMe" /><span>@Html.DisplayNameFor(m => m.RememberMe)</span></label>
            @if (error != null)
            {
                <p class="cf-auth__error" role="alert">@error</p>
                if (Model.NeedsConfirmation)
                {
                    <p class="cf-auth__foot"><a class="cf-auth__link" asp-action="ResendConfirmation" asp-route-email="@Model.Email">@L["Auth.ResendLink"]</a></p>
                }
            }
            <div><button type="submit" class="cf-auth__submit">@L["Auth.Login.Submit"]</button></div>
        </form>
        <p class="cf-auth__foot">@L["Auth.Login.NoAccount"] <a class="cf-auth__link" asp-action="Register">@L["Auth.Login.ToRegister"]</a></p>
    </div>
</div>
