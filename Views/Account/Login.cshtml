@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Auth.Login.Title"].Value;
    ViewData["AuthAside"] = true;
    // One message for the whole form: telling which field was wrong would reveal whether the account exists.
    var error = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).FirstOrDefault();
}
<div class="cf-auth cf-auth--login">
    <div class="cf-auth__card">
        <div class="cf-auth__head">
            <h1 class="cf-auth__title">@L["Auth.Login.Title"]</h1>
            <p class="cf-auth__sub">@L["Auth.Login.Sub"]</p>
        </div>
        <partial name="_Flash" />
        @if (error != null)
        {
            <div class="cf-alert app-auth-alert" role="alert">
                <span class="cf-icon cf-icon--alert-circle cf-icon--4" aria-hidden="true"></span>
                <div>
                    <p>@error</p>
                    @if (Model.NeedsConfirmation)
                    {
                        <p><a class="cf-auth__link" asp-action="ResendConfirmation" asp-route-email="@Model.Email">@L["Auth.ResendLink"]</a></p>
                    }
                </div>
            </div>
        }
        <form asp-action="Login" method="post" class="cf-stack-5" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="app-auth-field">
                <label class="cf-auth__label" asp-for="Email"></label>
                <div class="app-auth-input">
                    <span class="cf-icon cf-icon--mail cf-icon--4 app-auth-input__icon" aria-hidden="true"></span>
                    <input asp-for="Email" class="cf-auth__input" autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false"
                           placeholder="you@example.com" autofocus="@(string.IsNullOrEmpty(Model.Email) ? "autofocus" : null)" />
                </div>
            </div>
            <div class="app-auth-field">
                <div class="app-auth-label-row">
                    <label class="cf-auth__label" asp-for="Password"></label>
                    <a class="cf-auth__link app-auth-label-row__link" asp-action="ForgotPassword" asp-route-email="@Model.Email">@L["Auth.Forgot.Link"]</a>
                </div>
                <div class="app-auth-input app-password">
                    <span class="cf-icon cf-icon--lock cf-icon--4 app-auth-input__icon" aria-hidden="true"></span>
                    <input asp-for="Password" class="cf-auth__input" autocomplete="current-password" placeholder="••••••••"
                           autofocus="@(string.IsNullOrEmpty(Model.Email) ? null : "autofocus")" />
                    <partial name="_PasswordToggle" />
                </div>
                <p class="app-capslock" data-capslock hidden><span class="cf-icon cf-icon--alert cf-icon--3" aria-hidden="true"></span>@L["Auth.CapsLock"]</p>
            </div>
            <label class="cf-check"><input asp-for="RememberMe" /><span>@Html.DisplayNameFor(m => m.RememberMe)</span></label>
            <div class="app-auth-submit"><button type="submit" class="cf-auth__submit">@L["Auth.Login.Submit"]</button></div>
        </form>
        <div class="app-auth-switch">@L["Auth.Login.NoAccount"] <a class="cf-auth__link" asp-action="Register">@L["Auth.Login.ToRegister"]</a></div>
    </div>
</div>
