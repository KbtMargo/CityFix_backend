@model ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Auth.Reset.Title"].Value;
    var error = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).FirstOrDefault();
}
<div class="cf-auth cf-auth--login">
    <div class="cf-auth__card">
        <div class="cf-auth__head">
            <h1 class="cf-auth__title">@L["Auth.Reset.Title"]</h1>
            <p class="cf-auth__sub">@L["Auth.Reset.Sub"]</p>
        </div>
        <form asp-action="ResetPassword" method="post" class="cf-stack-6" novalidate>
            <input type="hidden" asp-for="Token" />
            <div><label class="cf-auth__label" asp-for="NewPassword"></label><input asp-for="NewPassword" class="cf-auth__input" autocomplete="new-password" /></div>
            <div><label class="cf-auth__label" asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="cf-auth__input" autocomplete="new-password" /></div>
            <p class="cf-field__hint">@L["Profile.PasswordHint"]</p>
            @if (error != null)
            {
                <p class="cf-auth__error" role="alert">@error</p>
            }
            <div><button type="submit" class="cf-auth__submit">@L["Auth.Reset.Submit"]</button></div>
        </form>
    </div>
</div>
