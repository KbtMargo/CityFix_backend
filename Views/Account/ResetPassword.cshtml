@model ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Auth.Reset.Title"].Value;
    ViewData["AuthAside"] = true;
}
<div class="cf-auth cf-auth--login">
    <div class="cf-auth__card">
        <div class="cf-auth__head">
            <h1 class="cf-auth__title">@L["Auth.Reset.Title"]</h1>
            <p class="cf-auth__sub">@L["Auth.Reset.Sub"]</p>
        </div>
        <form asp-action="ResetPassword" method="post" class="cf-stack-5" novalidate>
            <input type="hidden" asp-for="Token" />
            <div class="app-auth-field">
                <label class="cf-auth__label" asp-for="NewPassword"></label>
                <div class="app-auth-input app-password">
                    <span class="cf-icon cf-icon--lock cf-icon--4 app-auth-input__icon" aria-hidden="true"></span>
                    <input asp-for="NewPassword" class="cf-auth__input" autocomplete="new-password" placeholder="••••••••" data-password-new aria-describedby="password-rule" autofocus />
                    <partial name="_PasswordToggle" />
                </div>
                <span asp-validation-for="NewPassword" class="cf-field__error"></span>
                <p class="app-password-rule" id="password-rule" data-password-rule data-min="8">@L["Auth.Password.Rule", 8]</p>
                <p class="app-capslock" data-capslock hidden><span class="cf-icon cf-icon--alert cf-icon--3" aria-hidden="true"></span>@L["Auth.CapsLock"]</p>
            </div>
            <div class="app-auth-field">
                <label class="cf-auth__label" asp-for="ConfirmPassword"></label>
                <div class="app-auth-input app-password">
                    <span class="cf-icon cf-icon--lock cf-icon--4 app-auth-input__icon" aria-hidden="true"></span>
                    <input asp-for="ConfirmPassword" class="cf-auth__input" autocomplete="new-password" placeholder="••••••••" data-password-confirm />
                    <partial name="_PasswordToggle" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="cf-field__error"></span>
                <p class="app-password-rule" data-password-match hidden aria-live="polite"
                   data-text-ok="@L["Auth.Password.Match"]" data-text-bad="@L["Auth.Password.NoMatch"]"></p>
            </div>
            <div class="app-auth-submit"><button type="submit" class="cf-auth__submit">@L["Auth.Reset.Submit"]</button></div>
        </form>
        <div class="app-auth-switch"><a class="cf-auth__link app-auth-back" asp-action="Login"><span class="cf-icon cf-icon--arrow-left cf-icon--4" aria-hidden="true"></span>@L["Auth.BackToLogin"]</a></div>
    </div>
</div>
