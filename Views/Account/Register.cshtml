@model RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Auth.Register.Title"].Value;
    ViewData["AuthAside"] = true;
    // Field errors appear under their fields; anything not tied to a field goes on top.
    var formError = ViewData.ModelState.TryGetValue("", out var entry) ? entry.Errors.Select(e => e.ErrorMessage).FirstOrDefault() : null;
    var hasErrors = !ViewData.ModelState.IsValid;
}
<div class="cf-auth cf-auth--register">
    <div class="cf-auth__card cf-auth__card--wide">
        <div class="cf-auth__head">
            <h1 class="cf-auth__title">@L["Auth.Register.Title"]</h1>
            <p class="cf-auth__sub">@L["Auth.Register.Sub", L["App.Name"]]</p>
        </div>
        @if (hasErrors)
        {
            <div class="cf-alert app-auth-alert" role="alert">
                <span class="cf-icon cf-icon--alert-circle cf-icon--4" aria-hidden="true"></span>
                <p>@(formError ?? L["Auth.Register.FixErrors"].Value)</p>
            </div>
        }
        <form asp-action="Register" method="post" class="cf-stack-4" novalidate>
            <div class="app-auth-section" role="group" aria-labelledby="section-about">
                <h2 class="app-auth-section__title" id="section-about">@L["Auth.Register.AboutYou"]</h2>
                <div class="cf-form-grid">
                    <div class="app-auth-field">
                        <label class="cf-auth__label" asp-for="FirstName"></label>
                        <input asp-for="FirstName" class="cf-auth__input" autocomplete="given-name" placeholder="@L["Auth.Register.FirstNamePlaceholder"]" autofocus />
                        <span asp-validation-for="FirstName" class="cf-field__error"></span>
                    </div>
                    <div class="app-auth-field">
                        <label class="cf-auth__label" asp-for="LastName"></label>
                        <input asp-for="LastName" class="cf-auth__input" autocomplete="family-name" placeholder="@L["Auth.Register.LastNamePlaceholder"]" />
                        <span asp-validation-for="LastName" class="cf-field__error"></span>
                    </div>
                </div>
                <div class="app-auth-field">
                    <label class="cf-auth__label" asp-for="Phone"></label>
                    <input asp-for="Phone" class="cf-auth__input" type="tel" autocomplete="tel" inputmode="tel" placeholder="+380 50 123 45 67" />
                    <span asp-validation-for="Phone" class="cf-field__error"></span>                </div>
            </div>

            <div class="app-auth-section" role="group" aria-labelledby="section-signin">
                <h2 class="app-auth-section__title" id="section-signin">@L["Auth.Register.SignIn"]</h2>
                <div class="app-auth-field">
                    <label class="cf-auth__label" asp-for="Email"></label>
                    <div class="app-auth-input">
                        <span class="cf-icon cf-icon--mail cf-icon--4 app-auth-input__icon" aria-hidden="true"></span>
                        <input asp-for="Email" class="cf-auth__input" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" placeholder="you@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="cf-field__error"></span>
                    <p class="cf-field__hint">@L["Auth.Register.EmailHint"]</p>
                </div>
                <div class="cf-form-grid">
                    <div class="app-auth-field">
                        <label class="cf-auth__label" asp-for="Password"></label>
                        <div class="app-auth-input app-password">
                            <span class="cf-icon cf-icon--lock cf-icon--4 app-auth-input__icon" aria-hidden="true"></span>
                            <input asp-for="Password" class="cf-auth__input" autocomplete="new-password" placeholder="••••••••" data-password-new aria-describedby="password-rule" />
                            <partial name="_PasswordToggle" />
                        </div>
                        <span asp-validation-for="Password" class="cf-field__error"></span>
                        <p class="app-password-rule" id="password-rule" data-password-rule data-min="8">@L["Auth.Password.Rule", 8]</p>
                        <p class="app-capslock" data-capslock hidden><span class="cf-icon cf-icon--alert cf-icon--3" aria-hidden="true"></span>@L["Auth.CapsLock"]</p>
                    </div>
                    <div class="app-auth-field">
                        <label class="cf-auth__label" asp-for="ConfirmPassword"></label>
                        <div class="app-auth-input app-password">
                            <span class="cf-icon cf-icon--lock cf-icon--4 app-auth-input__icon" aria-hidden="true"></span>
                            <input asp-for="ConfirmPassword" class="cf-auth__input" autocomplete="new-password" placeholder="••••••••" data-password-confirm />
                            <partial name="_PasswordToggle" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="cf-field__error"></span>
                        <p class="app-password-rule" data-password-match hidden aria-live="polite"
                           data-text-ok="@L["Auth.Password.Match"]" data-text-bad="@L["Auth.Password.NoMatch"]"></p>
                    </div>
                </div>
            </div>

            <div class="app-auth-section" role="group" aria-labelledby="section-acab">
                <h2 class="app-auth-section__title" id="section-acab">@L["Field.Acab"]</h2>
                <label class="cf-check"><input asp-for="HasAssociation" data-acab-toggle /><span>@Html.DisplayNameFor(m => m.HasAssociation)</span></label>
                <div class="app-auth-field" data-acab-code>
                    <label class="cf-auth__label" asp-for="InvitationCode"></label>
                    <input asp-for="InvitationCode" class="cf-auth__input app-auth-code" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="@L["Auth.Register.CodePlaceholder"]" aria-describedby="code-hint" />
                    <span asp-validation-for="InvitationCode" class="cf-field__error"></span>
                    <p class="cf-field__hint" id="code-hint">@L["Auth.Register.CodeHint"]</p>
                </div>
            </div>

            <div class="app-auth-submit"><button type="submit" class="cf-auth__submit">@L["Auth.Register.Submit"]</button></div>
        </form>
        <div class="app-auth-switch">@L["Auth.Register.HaveAccount"] <a class="cf-auth__link" asp-action="Login">@L["Auth.Register.ToLogin"]</a></div>
    </div>
</div>
