@model ResendConfirmationViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Auth.Resend.Title"].Value;
    ViewData["AuthAside"] = true;
}
<div class="cf-auth cf-auth--login">
    <div class="cf-auth__card">
        <div class="cf-auth__head">
            <h1 class="cf-auth__title">@L["Auth.Resend.Title"]</h1>
            <p class="cf-auth__sub">@L["Auth.Resend.Sub"]</p>
        </div>
        <form asp-action="ResendConfirmation" method="post" class="cf-stack-5" novalidate>
            <div class="app-auth-field">
                <label class="cf-auth__label" asp-for="Email"></label>
                <div class="app-auth-input">
                    <span class="cf-icon cf-icon--mail cf-icon--4 app-auth-input__icon" aria-hidden="true"></span>
                    <input asp-for="Email" class="cf-auth__input" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" placeholder="you@example.com" autofocus />
                </div>
                <span asp-validation-for="Email" class="cf-field__error"></span>
            </div>
            <div class="app-auth-submit"><button type="submit" class="cf-auth__submit">@L["Auth.Resend.Submit"]</button></div>
        </form>
        <div class="app-auth-switch"><a class="cf-auth__link app-auth-back" asp-action="Login"><span class="cf-icon cf-icon--arrow-left cf-icon--4" aria-hidden="true"></span>@L["Auth.BackToLogin"]</a></div>
    </div>
</div>
