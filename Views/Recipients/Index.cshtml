@model TablePageViewModel<Recipient>
@{
    ViewData["Title"] = L["Recipients.Title"].Value;
}
<div>
    <a class="cf-back-link" asp-controller="Dashboard" asp-action="Index"><span class="cf-icon cf-icon--arrow-left cf-icon--4" aria-hidden="true"></span>@L["Common.BackToDashboard"]</a>
    <div class="cf-page-head">
        <h1 class="cf-page-title">@L["Recipients.Title"]</h1>
        <div class="cf-toolbar">
            <div class="cf-page-head__meta">@L["Recipients.Total"]: <b>@Model.Page.TotalCount</b></div>
            <a class="cf-btn cf-btn--icon-gap" asp-action="Create"><span class="cf-icon cf-icon--plus cf-icon--4" aria-hidden="true"></span>@L["Recipients.Add"]</a>
        </div>
    </div>
</div>

<div class="cf-table-card">
    <div class="cf-table-scroll">
        <table class="cf-table">
            <thead>
                <tr>
                    <th scope="col">@L["Field.Name"]</th>
                    <th scope="col">@L["Users.Col.Appeals"]</th>
                    <th scope="col" class="cf-center">@L["Table.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Page.Items.Count == 0)
                {
                    <tr><td colspan="3" class="cf-table__empty">@L["Recipients.Empty"]</td></tr>
                }
                @foreach (var r in Model.Page.Items)
                {
                    var appeals = Model.Count(r.Id);
                    <tr>
                        <td class="cf-strong">
                            <div class="cf-table__name">@r.Name</div>
                            @if (!string.IsNullOrWhiteSpace(r.ContactInfo))
                            {
                                <div class="cf-table__sub">@r.ContactInfo</div>
                            }
                        </td>
                        <td><span class="cf-tag @(appeals > 0 ? "cf-tag--count" : "cf-tag--zero")">@appeals</span></td>
                        <td>
                            <div class="cf-row-actions">
                                <a class="cf-icon-action cf-icon-action--edit" asp-action="Edit" asp-route-id="@r.Id" aria-label="@L["Common.EditItem", r.Name]"><span class="cf-icon cf-icon--edit cf-icon--4" aria-hidden="true"></span></a>
                                @if (appeals > 0)
                                {
                                    <button type="button" class="cf-icon-action cf-icon-action--delete" disabled aria-label="@L["Common.DeleteItem", r.Name]" title="@L["Common.HasAppeals"]"><span class="cf-icon cf-icon--trash cf-icon--4" aria-hidden="true"></span></button>
                                }
                                else
                                {
                                    <a class="cf-icon-action cf-icon-action--delete" asp-action="Delete" asp-route-id="@r.Id" aria-label="@L["Common.DeleteItem", r.Name]"><span class="cf-icon cf-icon--trash cf-icon--4" aria-hidden="true"></span></a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_PaginationBar" model="PaginationModel.For(Model.Page)" />
</div>
