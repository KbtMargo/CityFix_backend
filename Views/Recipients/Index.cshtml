@model IEnumerable<CityFix_backend.Models.Recipient>

@{
    ViewData["Title"] = L["Recipients"].Value;
}

<div class="page-header">
    <h1>@L["Recipients"]</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>@L["Add"]</a>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="card-body text-center text-secondary py-5">@L["No_Records"]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Name)</th>
                        <th>@Html.DisplayNameFor(model => model.ContactInfo)</th>
                        <th class="text-end">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold"><i class="bi bi-bank text-primary me-2"></i>@item.Name</td>
                            <td class="text-secondary">@item.ContactInfo</td>
                            <td class="text-end"><partial name="_RowActions" model="item.Id" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
