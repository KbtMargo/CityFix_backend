@model CityFix_backend.Models.Recipient

@{
    ViewData["Title"] = $"{L["Page_Create"]} · {L["Recipient"]}";
}

<div class="page-header">
    <div>
        <div class="eyebrow">@L["Recipient"]</div>
        <h1>@L["Page_Create"]</h1>
    </div>
</div>

<div class="card form-card">
    <div class="card-body p-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <partial name="_Form" />
            <div class="d-flex gap-2 mt-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>@L["Create"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@L["Back to list"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
