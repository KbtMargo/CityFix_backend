@model CityFix_backend.Models.Recipient

<div class="card form-card">
    <div class="card-body p-4">
        <dl class="row detail-list mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-9 fw-semibold">@Model.Name</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ContactInfo)</dt>
            <dd class="col-sm-9 mb-0" style="white-space: pre-line">@(string.IsNullOrWhiteSpace(Model.ContactInfo) ? "—" : Model.ContactInfo)</dd>
        </dl>
    </div>
</div>
