@model Recipient
<div>
    <label class="cf-label" asp-for="Name"></label>
    <label class="cf-field"><input asp-for="Name" class="@(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "cf-input cf-input--error" : "cf-input")" placeholder="@L["Recipients.NamePlaceholder"]" /></label>
    <span asp-validation-for="Name" class="cf-field__error"></span>
</div>
<div>
    <label class="cf-label" asp-for="ContactInfo">@L["Field.ContactInfoOptional"]</label>
    <label class="cf-field"><textarea asp-for="ContactInfo" class="cf-textarea" rows="3" placeholder="@L["Recipients.ContactPlaceholder"]"></textarea></label>
    <span asp-validation-for="ContactInfo" class="cf-field__error"></span>
</div>
