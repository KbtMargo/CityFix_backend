@model CityFix_backend.Models.Recipient

@{
    ViewData["Title"] = $"{L["Page_Details"]} · {L["Recipient"]}";
}

<div class="page-header">
    <div>
        <div class="eyebrow">@L["Recipient"] #@Model.Id</div>
        <h1>@L["Page_Details"]</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>@L["Edit"]</a>
        <a asp-action="Index" class="btn btn-outline-secondary">@L["Back to list"]</a>
    </div>
</div>

<partial name="_Summary" />
