@{
    ViewData["Title"] = "CityFix";
}

<section class="hero mb-4">
    <h1 class="mb-3">@L["Home_Title"]</h1>
    <p class="lead mb-4">@L["Home_Lead"]</p>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-light btn-lg" asp-controller="Appeals" asp-action="Index">
            <i class="bi bi-card-list me-1"></i>@L["Home_ViewAppeals"]
        </a>
        <a class="btn btn-outline-light btn-lg" asp-controller="Appeals" asp-action="Create">
            <i class="bi bi-plus-circle me-1"></i>@L["Home_SubmitAppeal"]
        </a>
    </div>
</section>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <span class="feature-icon mb-3"><i class="bi bi-geo-alt"></i></span>
                <h2 class="h5">@L["Home_F1_Title"]</h2>
                <p class="text-secondary mb-0">@L["Home_F1_Text"]</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <span class="feature-icon mb-3"><i class="bi bi-bank"></i></span>
                <h2 class="h5">@L["Home_F2_Title"]</h2>
                <p class="text-secondary mb-0">@L["Home_F2_Text"]</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <span class="feature-icon mb-3"><i class="bi bi-activity"></i></span>
                <h2 class="h5">@L["Home_F3_Title"]</h2>
                <p class="text-secondary mb-0">@L["Home_F3_Text"]</p>
            </div>
        </div>
    </div>
</div>

<div class="text-secondary small">
    <p class="mb-1">@L["Home_About"]</p>
    <p class="mb-0">
        @L["Student"]: Kubata Marharyta &middot; @L["Group"]: SEs-26-1 &middot; @L["University"]: Khmelnytskyi National University
    </p>
</div>
