@model Acab
@{
    ViewData["Title"] = L["Acabs.DeleteTitle"].Value;
    var members = ViewData["MemberCount"] as int? ?? 0;
    var dialog = new DeleteDialogModel(
        Model.Id,
        L["Acabs.DeleteTitle"],
        L["Common.CannotUndo"],
        L["Common.Delete"],
        "Index",
        BlockedTitle: members > 0 ? L["Acabs.CannotDeleteTitle"].Value : null,
        BlockedText: members > 0 ? L["Acabs.CannotDeleteText", members].Value : null);
}
<partial name="_DeleteDialog" model="dialog" />
