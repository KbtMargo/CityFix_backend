@model AcabFormViewModel
@{
    string InputClass(string field) => ViewData.ModelState[field]?.Errors.Count > 0 ? "cf-input cf-input--error" : "cf-input";
}
<div>
    <label class="cf-label" asp-for="Name"></label>
    <label class="cf-field"><input asp-for="Name" class="@InputClass("Name")" /></label>
    <span asp-validation-for="Name" class="cf-field__error"></span>
</div>
<div>
    <label class="cf-label" asp-for="Address">@L["Field.AddressOptional"]</label>
    <label class="cf-field"><input asp-for="Address" class="@InputClass("Address")" /></label>
    <span asp-validation-for="Address" class="cf-field__error"></span>
</div>
