@model TablePageViewModel<AcabRow>
@{
    ViewData["Title"] = L["Acabs.Title"].Value;
}
<div>
    <a class="cf-back-link" asp-controller="Dashboard" asp-action="Index"><span class="cf-icon cf-icon--arrow-left cf-icon--4" aria-hidden="true"></span>@L["Common.BackToDashboard"]</a>
    <div class="cf-page-head">
        <h1 class="cf-page-title">@L["Acabs.Title"]</h1>
        <div class="cf-toolbar">
            <div class="cf-page-head__meta">@L["Acabs.Total"]: <b>@Model.Page.TotalCount</b></div>
            <a class="cf-btn cf-btn--icon-gap" asp-action="Create"><span class="cf-icon cf-icon--plus cf-icon--4" aria-hidden="true"></span>@L["Acabs.Add"]</a>
        </div>
    </div>
</div>

<partial name="_TableSearch" model="Model.Q" />

<div class="cf-table-card">
    <div class="cf-table-scroll">
        <table class="cf-table">
            <thead>
                <tr>
                    <th scope="col">@L["Field.Name"]</th>
                    <th scope="col">@L["Field.ResidentCode"]</th>
                    <th scope="col">@L["Field.HeadCode"]</th>
                    <th scope="col">@L["Acabs.Col.Members"]</th>
                    <th scope="col">@L["Users.Col.Appeals"]</th>
                    <th scope="col" class="cf-center">@L["Table.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Page.Items.Count == 0)
                {
                    <tr><td colspan="6" class="cf-table__empty">@L[string.IsNullOrWhiteSpace(Model.Q) ? "Acabs.Empty" : "Empty.Filtered"]</td></tr>
                }
                @foreach (var row in Model.Page.Items)
                {
                    var a = row.Acab;
                    <tr>
                        <td class="cf-strong">
                            <div class="cf-table__name">@a.DisplayName()</div>
                            @if (!string.IsNullOrWhiteSpace(a.Address))
                            {
                                <div class="cf-table__sub">@a.DisplayAddress()</div>
                            }
                        </td>
                        <td><code>@a.ResidentCode</code></td>
                        <td><code>@a.HeadCode</code></td>
                        <td><span class="cf-tag @(row.MemberCount > 0 ? "cf-tag--count" : "cf-tag--zero")">@row.MemberCount</span></td>
                        <td><span class="cf-tag @(row.AppealCount > 0 ? "cf-tag--count" : "cf-tag--zero")">@row.AppealCount</span></td>
                        <td>
                            <div class="cf-row-actions">
                                <a class="cf-icon-action cf-icon-action--edit" asp-action="Edit" asp-route-id="@a.Id" aria-label="@L["Common.EditItem", a.DisplayName()]"><span class="cf-icon cf-icon--edit cf-icon--4" aria-hidden="true"></span></a>
                                @if (!row.CanDelete)
                                {
                                    <button type="button" class="cf-icon-action cf-icon-action--delete" disabled aria-label="@L["Common.DeleteItem", a.DisplayName()]" title="@L["Acabs.CannotDelete"]"><span class="cf-icon cf-icon--trash cf-icon--4" aria-hidden="true"></span></button>
                                }
                                else
                                {
                                    <a class="cf-icon-action cf-icon-action--delete" asp-action="Delete" asp-route-id="@a.Id" aria-label="@L["Common.DeleteItem", a.DisplayName()]"><span class="cf-icon cf-icon--trash cf-icon--4" aria-hidden="true"></span></a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_PaginationBar" model="PaginationModel.For(Model.Page, Model.Q)" />
</div>
