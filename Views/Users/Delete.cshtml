@model DeleteCheck
@{
    ViewData["Title"] = L["Users.DeleteTitle"].Value;
    var dialog = new DeleteDialogModel(
        Model.Id,
        L["Users.DeleteTitle"],
        L["Users.DeleteText", Model.Name],
        L["Common.Delete"],
        "Index",
        BlockedTitle: Model.Blocked ? L["Users.CannotDeleteTitle"].Value : null,
        BlockedText: Model.Blocked ? L[Model.BlockedKey!, Model.UsageCount].Value : null);
}
<partial name="_DeleteDialog" model="dialog" />
