@model UserFormViewModel
@{
    string InputClass(string field) => ViewData.ModelState[field]?.Errors.Count > 0 ? "cf-input cf-input--error" : "cf-input";
}
<div class="cf-form-grid">
    <div>
        <label class="cf-label" asp-for="FirstName"></label>
        <label class="cf-field"><input asp-for="FirstName" class="@InputClass("FirstName")" autocomplete="off" /></label>
        <span asp-validation-for="FirstName" class="cf-field__error"></span>
    </div>
    <div>
        <label class="cf-label" asp-for="LastName"></label>
        <label class="cf-field"><input asp-for="LastName" class="@InputClass("LastName")" autocomplete="off" /></label>
        <span asp-validation-for="LastName" class="cf-field__error"></span>
    </div>
</div>
<div>
    <label class="cf-label" asp-for="Email"></label>
    <label class="cf-field"><input asp-for="Email" class="@InputClass("Email")" autocomplete="off" /></label>
    <span asp-validation-for="Email" class="cf-field__error"></span>
</div>
<div>
    <label class="cf-label" asp-for="Phone">@L["Field.PhoneOptional"]</label>
    <label class="cf-field"><input asp-for="Phone" class="@InputClass("Phone")" type="tel" autocomplete="off" placeholder="+380..." /></label>
    <span asp-validation-for="Phone" class="cf-field__error"></span>
</div>
<div class="cf-form-grid">
    <div>
        <label class="cf-label" asp-for="Role"></label>
        <div class="cf-select app-control-gap"><select asp-for="Role" asp-items="Html.GetEnumSelectList<UserRole>()"></select></div>
        <span asp-validation-for="Role" class="cf-field__error"></span>
    </div>
    <div>
        <label class="cf-label" asp-for="AcabId"></label>
        <div class="cf-select app-control-gap">
            <select asp-for="AcabId">
                <option value="">@L["Common.NotSpecified"]</option>
                @foreach (var a in Model.Acabs)
                {
                    <option value="@a.Id" selected="@(Model.AcabId == a.Id)">@a.DisplayName()</option>
                }
            </select>
        </div>
        <p class="cf-field__hint">@L["Users.AcabHint"]</p>
        <span asp-validation-for="AcabId" class="cf-field__error"></span>
    </div>
</div>
