@model IEnumerable<CityFix_backend.Models.User>

@{
    ViewData["Title"] = L["Users"].Value;
}

<div class="page-header">
    <h1>@L["Users"]</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>@L["Add"]</a>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="card-body text-center text-secondary py-5">@L["No_Records"]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.FirstName)</th>
                        <th>@Html.DisplayNameFor(model => model.Email)</th>
                        <th>@Html.DisplayNameFor(model => model.Phone)</th>
                        <th>@Html.DisplayNameFor(model => model.Role)</th>
                        <th>@Html.DisplayNameFor(model => model.Acab)</th>
                        <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
                        <th class="text-end">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.FirstName @item.LastName</td>
                            <td>@item.Email</td>
                            <td class="text-nowrap">@item.Phone</td>
                            <td><span class="badge text-bg-light border">@L.EnumText(item.Role)</span></td>
                            <td>@item.Acab?.Name</td>
                            <td class="text-nowrap">@item.CreatedAt.ToUiString()</td>
                            <td class="text-end"><partial name="_RowActions" model="item.Id" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
