@model UsersIndexViewModel
@{
    ViewData["Title"] = L["Users.Title"].Value;
    var rows = Model.Data.Page;
    var ownAcab = Model.Data.OwnAcab;
    var filterAcab = Model.Data.FilterAcab;
}
<div>
    @if (filterAcab != null)
    {
        <a class="cf-back-link" asp-controller="Acabs" asp-action="Index"><span class="cf-icon cf-icon--arrow-left cf-icon--4" aria-hidden="true"></span>@L["Users.BackToAcabs"]</a>
    }
    else
    {
        <a class="cf-back-link" asp-controller="Dashboard" asp-action="Index"><span class="cf-icon cf-icon--arrow-left cf-icon--4" aria-hidden="true"></span>@L["Common.BackToDashboard"]</a>
    }
    <div class="cf-page-head">
        <h1 class="cf-page-title">@(filterAcab != null ? L["Users.AcabMembers", filterAcab.DisplayName()] : L["Users.Title"])</h1>
        <div class="cf-toolbar">
            <div class="cf-page-head__meta">@L["Users.Total"]: <b>@rows.TotalCount</b></div>
            @if (Model.IsAdministrator)
            {
                <a class="cf-btn cf-btn--icon-gap" asp-action="Create"><span class="cf-icon cf-icon--plus cf-icon--4" aria-hidden="true"></span>@L["Users.Add"]</a>
            }
        </div>
    </div>
</div>

@if (ownAcab != null)
{
    <div class="cf-box app-code-row">
        <div>
            <div class="cf-label">@L["Users.ResidentCodeFor", ownAcab.DisplayName()]</div>
            <code class="app-code">@ownAcab.ResidentCode</code>
            <p class="cf-field__hint">@L["Users.ResidentCodeHint"]</p>
        </div>
    </div>
}

@if (filterAcab != null)
{
    <p class="cf-page-sub">
        @L["Users.AcabMembersHint"]
        <a class="app-link" asp-action="Index">@L["Users.ShowAll"]</a>
    </p>
}

@{
    var searchData = new ViewDataDictionary(ViewData);
    if (filterAcab != null)
    {
        searchData["SearchKeep"] = new Dictionary<string, string> { ["acabId"] = filterAcab.Id.ToString() };
    }
}
<partial name="_TableSearch" model="Model.Q" view-data="searchData" />

<div class="cf-table-card">
    <div class="cf-table-scroll">
        <table class="cf-table">
            <thead>
                <tr>
                    <th scope="col">@L["Users.Col.User"]</th>
                    <th scope="col">@L["Field.Email"]</th>
                    <th scope="col">@L["Field.Role"]</th>
                    <th scope="col">@L["Field.Acab"]</th>
                    <th scope="col">@L["Users.Col.Appeals"]</th>
                    <th scope="col">@L["Users.Col.Registered"]</th>
                    @if (Model.IsAdministrator)
                    {
                        <th scope="col" class="cf-center">@L["Table.Actions"]</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (rows.Items.Count == 0)
                {
                    <tr><td colspan="@(Model.IsAdministrator ? 7 : 6)" class="cf-table__empty">@L[string.IsNullOrWhiteSpace(Model.Q) ? "Users.Empty" : "Empty.Filtered"]</td></tr>
                }
                @foreach (var row in rows.Items)
                {
                    var u = row.User;
                    <tr>
                        <td class="cf-strong">
                            <div class="cf-table__name"><a class="app-table-link" asp-action="Details" asp-route-id="@u.Id">@u.DisplayName()</a></div>
                            @if (!string.IsNullOrWhiteSpace(u.Phone))
                            {
                                <div class="cf-table__sub">@u.Phone</div>
                            }
                            @if (u.IsBlocked)
                            {
                                <span class="cf-badge cf-badge--danger app-table-badge">@L["Users.BlockedBadge"]</span>
                            }
                        </td>
                        <td>@u.Email</td>
                        <td><span class="cf-tag cf-tag--@u.Role.RoleTag()">@u.Role.GetDisplayName()</span></td>
                        <td>@(u.Acab?.DisplayName() ?? L["Common.NotSpecified"].Value)</td>
                        <td><span class="cf-tag @(row.AppealCount > 0 ? "cf-tag--count" : "cf-tag--zero")">@row.AppealCount</span></td>
                        <td>@u.CreatedAt.ToDate()</td>
                        @if (Model.IsAdministrator)
                        {
                            <td>
                                <div class="cf-row-actions">
                                    <a class="cf-icon-action cf-icon-action--edit" asp-action="Edit" asp-route-id="@u.Id" aria-label="@L["Common.EditItem", u.DisplayName()]"><span class="cf-icon cf-icon--edit cf-icon--4" aria-hidden="true"></span></a>
                                    @if (!row.CanDelete)
                                    {
                                        <button type="button" class="cf-icon-action cf-icon-action--delete" disabled aria-label="@L["Common.DeleteItem", u.DisplayName()]" title="@L[row.DeleteBlockedKey!]"><span class="cf-icon cf-icon--trash cf-icon--4" aria-hidden="true"></span></button>
                                    }
                                    else
                                    {
                                        <a class="cf-icon-action cf-icon-action--delete" asp-action="Delete" asp-route-id="@u.Id" aria-label="@L["Common.DeleteItem", u.DisplayName()]"><span class="cf-icon cf-icon--trash cf-icon--4" aria-hidden="true"></span></a>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_PaginationBar" model="PaginationModel.For(rows, Model.Route())" />
</div>
