@model AppealListViewModel
@{
    ViewData["Title"] = Model.IsStaff ? L["Appeals.AllTitle"].Value : L["Appeals.MyTitle"].Value;
}

@if (!Model.IsStaff)
{
    <div>
        <h1 class="cf-page-title">@L["Appeals.MyTitle"]</h1>
        <p class="cf-page-sub">@L["Appeals.MySub"]</p>
    </div>
    <partial name="_AppealFilters" model="Model" />
    <partial name="_StatusTabs" model="Model" />
    <partial name="_IssueList" model="Model" />
}
else
{
    <div>
        <a class="cf-back-link" asp-controller="Dashboard" asp-action="Index"><span class="cf-icon cf-icon--arrow-left cf-icon--4" aria-hidden="true"></span>@L["Common.BackToDashboard"]</a>
        <div class="cf-page-head">
            <h1 class="cf-page-title">@L["Appeals.AllTitle"]</h1>
            <div class="cf-page-head__meta">@L["Appeals.Total"]: <b>@Model.Page.TotalCount</b></div>
        </div>
    </div>
    <partial name="_AppealFilters" model="Model" />
    <partial name="_StatusTabs" model="Model" />

    <div class="cf-table-card">
        <div class="cf-table-scroll">
            <table class="cf-table">
                <thead>
                    <tr>
                        <th scope="col">@L["Table.Appeal"]</th>
                        <th scope="col">@L["Field.Status"]</th>
                        <th scope="col">@L["Field.Priority"]</th>
                        <th scope="col">@L["Field.Category"]</th>
                        <th scope="col">@L["Field.Author"]</th>
                        <th scope="col">@L["Table.Date"]</th>
                        <th scope="col" class="cf-center">@L["Table.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Page.Items.Count == 0)
                    {
                        <tr><td colspan="7" class="cf-table__empty">@L["Empty.Filtered"]</td></tr>
                    }
                    @foreach (var a in Model.Page.Items)
                    {
                        var route = Model.Filter.ToRouteValues(includePage: true);
                        route["appealId"] = a.Id.ToString();
                        <tr>
                            <td class="cf-strong">
                                <div class="cf-table__name"><a asp-action="Index" asp-all-route-data="route">@a.Title</a></div>
                                <div class="cf-table__sub">@(a.Address ?? L["Appeal.Coordinates", a.Lat.Coordinate(), a.Lng.Coordinate()].Value)</div>
                            </td>
                            <td><partial name="_StatusPill" model="a.Status" /></td>
                            <td><partial name="_PriorityPill" model="a.Priority" /></td>
                            <td>@a.Category?.Name</td>
                            <td>@a.Author?.FirstName @a.Author?.LastName</td>
                            <td>@a.CreatedAt.ToDate()</td>
                            <td>
                                <div class="cf-row-actions">
                                    <a class="cf-icon-action cf-icon-action--edit" asp-action="Edit" asp-route-id="@a.Id" aria-label="@L["Common.EditItem", a.Title]"><span class="cf-icon cf-icon--edit cf-icon--4" aria-hidden="true"></span></a>
                                    <a class="cf-icon-action cf-icon-action--delete" asp-action="Delete" asp-route-id="@a.Id" aria-label="@L["Common.DeleteItem", a.Title]"><span class="cf-icon cf-icon--trash cf-icon--4" aria-hidden="true"></span></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_PaginationBar" model="PaginationModel.For(Model.Page, Model.Filter.ToRouteValues())" />
    </div>
}

@if (Model.Selected != null)
{
    <partial name="_AppealModal" model="Model" />
}
