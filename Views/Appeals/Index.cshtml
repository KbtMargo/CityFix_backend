@model IEnumerable<CityFix_backend.Models.Appeal>
@using System.Globalization

@{
    ViewData["Title"] = L["Appeals"].Value;

    string Location(Appeal a) => !string.IsNullOrWhiteSpace(a.Address)
        ? a.Address
        : $"{a.Lat.ToString(CultureInfo.InvariantCulture)}, {a.Lng.ToString(CultureInfo.InvariantCulture)}";
}

<div class="page-header">
    <h1>@L["Appeals"]</h1>
    <div class="d-flex flex-wrap gap-2">
        <div class="btn-group view-switch" role="group" aria-label="@L["View mode"]">
            <button type="button" class="btn btn-outline-secondary active" data-view-mode="cards" title="@L["View_Cards"]">
                <i class="bi bi-grid-3x2-gap"></i><span class="d-none d-md-inline ms-1">@L["View_Cards"]</span>
            </button>
            <button type="button" class="btn btn-outline-secondary" data-view-mode="list" title="@L["View_List"]">
                <i class="bi bi-view-list"></i><span class="d-none d-md-inline ms-1">@L["View_List"]</span>
            </button>
            <button type="button" class="btn btn-outline-secondary" data-view-mode="table" title="@L["View_Table"]">
                <i class="bi bi-table"></i><span class="d-none d-md-inline ms-1">@L["View_Table"]</span>
            </button>
        </div>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>@L["Add"]</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card"><div class="card-body text-center text-secondary py-5">@L["No_Records"]</div></div>
}
else
{
    <div id="appeals" data-view="cards">
        <div class="row g-3 appeal-grid">
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-xl-4 appeal-col">
                    <article class="card appeal-card h-100">
                        <div class="card-body">
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <partial name="_StatusBadge" model="item.Status" />
                                <partial name="_PriorityBadge" model="item.Priority" />
                            </div>
                            <h2 class="card-title">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-reset text-decoration-none">@item.Title</a>
                            </h2>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p class="card-text text-secondary appeal-desc">@item.Description</p>
                            }
                            <ul class="list-unstyled small text-secondary mb-0">
                                <li><i class="bi bi-geo-alt me-1"></i>@Location(item)</li>
                                <li><i class="bi bi-tag me-1"></i>@item.Category?.Name</li>
                                <li><i class="bi bi-bank me-1"></i>@item.Recipient?.Name</li>
                                <li><i class="bi bi-person me-1"></i>@item.Author?.Email</li>
                            </ul>
                        </div>
                        <div class="card-footer d-flex justify-content-between align-items-center">
                            <small class="text-secondary"><i class="bi bi-clock me-1"></i>@item.CreatedAt.ToUiString()</small>
                            <partial name="_RowActions" model="item.Id" />
                        </div>
                    </article>
                </div>
            }
        </div>

        <div class="card appeal-table">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Title)</th>
                            <th>@Html.DisplayNameFor(model => model.Status)</th>
                            <th>@Html.DisplayNameFor(model => model.Priority)</th>
                            <th>@Html.DisplayNameFor(model => model.Category)</th>
                            <th>@Html.DisplayNameFor(model => model.Recipient)</th>
                            <th>@Html.DisplayNameFor(model => model.Author)</th>
                            <th>@L["Location"]</th>
                            <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
                            <th class="text-end">@L["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Title</td>
                                <td><partial name="_StatusBadge" model="item.Status" /></td>
                                <td><partial name="_PriorityBadge" model="item.Priority" /></td>
                                <td>@item.Category?.Name</td>
                                <td>@item.Recipient?.Name</td>
                                <td>@item.Author?.Email</td>
                                <td>@Location(item)</td>
                                <td class="text-nowrap">@item.CreatedAt.ToUiString()</td>
                                <td class="text-end"><partial name="_RowActions" model="item.Id" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
