@model Appeal
@{
    ViewData["Title"] = L["Appeals.EditTitle"].Value;
}
@section Head {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"
          integrity="sha384-c6Rcwz4e4CITMbu/NBmnNS8yN2sC3cUElMEMfP3vqqKFp7GOYaaBBCqmaWBjmkjb" crossorigin="anonymous" />
}

<div class="cf-form-page">
    <a class="cf-back-link" asp-action="Index" asp-route-appealId="@Model.Id"><span class="cf-icon cf-icon--arrow-left cf-icon--4" aria-hidden="true"></span>@L["Appeals.BackToAppeal"]</a>
    <h1 class="cf-form-page__title">@L["Appeals.EditTitle"]</h1>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="cf-form-card">
        <input type="hidden" asp-for="Id" />
        <partial name="_Form" />
        <div asp-validation-summary="ModelOnly" class="cf-auth__error"></div>
        <button type="submit" class="cf-btn cf-btn--block">@L["Common.SaveChanges"]</button>
    </form>
</div>

@section Scripts {
    <partial name="_FormAssets" />
}
