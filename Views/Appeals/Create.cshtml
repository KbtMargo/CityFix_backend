@model Appeal
@{
    ViewData["Title"] = L["Appeals.CreateTitle"].Value;
}
@section Head {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"
          integrity="sha384-c6Rcwz4e4CITMbu/NBmnNS8yN2sC3cUElMEMfP3vqqKFp7GOYaaBBCqmaWBjmkjb" crossorigin="anonymous" />
}

<div class="cf-form-page">
    <h1 class="cf-form-page__title">@L["Appeals.CreateTitle"]</h1>
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="cf-form-card">
        <partial name="_Form" />
        <div asp-validation-summary="ModelOnly" class="cf-auth__error"></div>
        <button type="submit" class="cf-btn cf-btn--block">@L["Appeals.CreateSubmit"]</button>
    </form>
</div>

@section Scripts {
    <partial name="_FormAssets" />
}
